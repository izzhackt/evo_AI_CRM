# EVO Admissions CRM local example.
# Copy to .env.local and supply real values locally. Never commit .env.local.

NODE_ENV=development
# Active V2 local database foundation. The app reads only DATABASE_URL and
# fails closed if it is missing or malformed. Keep the real value only in
# ignored .env.local or another private secret store.
DATABASE_URL=

# Active V2 private document bytes. Required whenever DATABASE_URL enables V2.
# Set an existing dedicated absolute directory outside public/static paths in
# ignored local env only. Missing or invalid storage fails closed; the
# application has no Supabase or public-file fallback.
EVO_PRIVATE_DOCUMENT_ROOT=

# Private local V2 access gate. Put independent high-entropy values in ignored
# .env.local only. These three profiles are technical role selectors, not staff
# accounts; there is no signup, recovery or provider-backed identity.
EVO_DEV_GATE_SESSION_SECRET=
EVO_DEV_GATE_ADMIN_IDENTIFIER=
EVO_DEV_GATE_ADMIN_SECRET=
EVO_DEV_GATE_SALES_IDENTIFIER=
EVO_DEV_GATE_SALES_SECRET=
EVO_DEV_GATE_ADMISSIONS_IDENTIFIER=
EVO_DEV_GATE_ADMISSIONS_SECRET=

# Active V2 receive-only WhatsApp ingress. Keep the HMAC secret server-only in
# ignored local env. Missing configuration fails closed; the old root webhooks
# and workers are not a fallback path.
EVO_V2_WHATSAPP_INBOUND_HMAC_SECRET=

# Local Compose bootstrap values. The validation harness generates them in a
# temporary ignored env file; these are not application fallback settings.
POSTGRES_USER=evo
POSTGRES_PASSWORD=
POSTGRES_DB=evo
POSTGRES_PORT=55432

# Frozen V1 browser/runtime settings remain historical until their owning V2
# replacement slices delete them. They are not authority for the active V2
# database foundation.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:45421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shared server-only backend identity retained by outbound messaging work until
# #433 replaces that surface. Never expose the secret through NEXT_PUBLIC_*.
EVO_PLATFORM_ORGANIZATION_ID=
EVO_PLATFORM_SUPABASE_SECRET_KEY=

# P7B private CRM readiness and Prometheus metrics. The route signature secret
# is backend-only, distinct from every provider/worker secret, and 32-128 bytes.
EVO_PLATFORM_P7B_OBSERVABILITY_ENABLED=0
EVO_PLATFORM_P7B_OBSERVABILITY_SECRET=

# P4R1 bounded live amoCRM canonical context. This lane is read-only and
# disabled by default. The browser must never receive the amoCRM token, raw
# provider response, provider IDs or a NEXT_PUBLIC_* copy of these values.
EVO_PLATFORM_AMOCRM_READ_ENABLED=0
EVO_PLATFORM_AMOCRM_ACCOUNT_DOMAIN=
EVO_PLATFORM_AMOCRM_READ_TOKEN=

# P5F1 staff-controlled AI memory and degraded lexical knowledge preview.
# The foundation remains fail-closed until the server explicitly enables it;
# this flag never authorizes autonomous replies or provider execution.
EVO_PLATFORM_AI_MEMORY_ENABLED=0

# Staff-only knowledge drafts stay fail-closed until their later V2 product
# slice replaces this retained repository and explicitly enables the path. The
# provider secret and canonical knowledge account never belong in browser code.
EVO_PLATFORM_STAFF_ASSISTANT_ENABLED=0
EVO_PLATFORM_KNOWLEDGE_ACCOUNT_ID=
EVO_PLATFORM_GEMINI_API_KEY=

# V2-10A canonical Gemini reply proposals. This permanent advisory product path
# remains server-only and stays blocked unless both exact flags are 1. The model
# has no implicit default and must be named explicitly. A successful real
# proposal is stored for human review only; it cannot send WhatsApp, write
# amoCRM, or authorize an autonomous action.
EVO_V2_GEMINI_PROPOSALS_ENABLED=0
EVO_V2_GEMINI_PROVIDER_AUTHORIZED=0
EVO_V2_GEMINI_MODEL=
EVO_V2_GEMINI_TIMEOUT_MS=15000
EVO_V2_GEMINI_API_KEY=

# V2-9C canonical read-only WAHA preflight. This server-only path stays blocked
# unless both exact flags are 1. It inspects only the configured private WAHA
# runtime and session state; it never sends WhatsApp, writes amoCRM, or
# authorizes autonomous work.
EVO_V2_WAHA_PREFLIGHT_ENABLED=0
EVO_V2_WAHA_PROVIDER_AUTHORIZED=0
EVO_V2_WAHA_BASE_URL=
EVO_V2_WAHA_API_KEY=
EVO_V2_WAHA_SESSION_NAME=

# P6A read-only Student Portal attention presentation. This server-only flag
# changes no notification, acknowledgement, scheduler, provider, or durable state.
# It is fail-closed unless the exact value is 1.
EVO_PLATFORM_P6A_PORTAL_ATTENTION_ENABLED=0

# P6B durable Student Portal document-review notifications. This server-only
# lane stays disabled unless the exact value is 1 and the exact organization is
# enabled by the private database runtime control. It never creates WhatsApp or
# other delivery intents; browser subscriptions receive empty invalidations.
EVO_PLATFORM_P6B_PORTAL_NOTIFICATIONS_ENABLED=0

# P6C bounded overdue-transition producer. The private POST trigger and every
# database organization control remain disabled unless explicitly enabled.
# It only creates durable in-app task/payment notifications; it never sends
# WhatsApp, calls a provider, infers deadlines, or accepts mutable work input.
# Keep the accepted P6B flag enabled with P6C so the same private Realtime
# invalidation channel and durable document-review feed remain active.
EVO_PLATFORM_P6C_OVERDUE_NOTIFICATIONS_ENABLED=0
EVO_PLATFORM_P6C_OVERDUE_TRIGGER_SECRET=

# P7A Admin-only safe audit search and CSV export. This server-only flag is
# disabled by default; enabling it exposes only the reviewed safe projection
# through actor-authorized Platform RPCs and never restores raw audit-table reads.
EVO_PLATFORM_P7A_AUDIT_ENABLED=0

# Legacy SQLite settings below belong only to the separate legacy CRM and the
# explicit non-production UI-contract fixture suite. Platform runtime does not
# import, map, dual-read or fall back to these accounts or records.
# Use independent, high-entropy values. Production refuses to store/decrypt
# runtime provider secrets without EVO_SECRET_ENCRYPTION_KEY.
AUTH_SECRET=
EVO_SECRET_ENCRYPTION_KEY=
EVO_DB_PATH=data/edu-admin.db
EVO_BACKUP_DIR=output/backups

# An empty non-production database is automatically filled with demo data,
# regardless of this flag. In production, demo seeding stays blocked unless
# this is explicitly set to 1. Never enable it in production.
EVO_ALLOW_DEMO_SEED=0
# Never enable this in a production build. The app rejects it when
# NODE_ENV=production.
EVO_UI_CONTRACT_FIXTURES=0

# Optional CRM-side transcription providers. Empty means not configured.
ZAI_API_KEY=
ZAI_CODING_PLAN_API_KEY=
ZAI_CODING_PLAN_BASE_URL=
NEXT_PUBLIC_TRANSCRIPTION_SPLINE_SCENE_URL=
EVO_ENABLE_LOCAL_TRANSCRIPTION=0
# Provider credentials alone do not approve sending transcript content.
EVO_ENABLE_EXTERNAL_TRANSCRIPT_IMPROVEMENT=0

# First admin bootstrap values should be passed only to the one-time command,
# not stored here: EVO_ADMIN_EMAIL, EVO_ADMIN_PASSWORD, EVO_ADMIN_NAME, and
# optional EVO_ADMIN_PHONE.
