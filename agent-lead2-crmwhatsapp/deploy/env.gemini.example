# Runtime seed env for the EVO Inbox account-level Gemini AI config.
# Copy to /opt/evo-inbox/agent-lead2-crmwhatsapp/.env.gemini on the target
# host and replace placeholders there. Do not commit real values.
#
# This file is loaded only while running `npm run seed:prod-ai`; the script
# validates the key against Google, then stores it encrypted in Supabase
# `ai_configs.api_key`. The app does not need this plaintext key after seeding.

EVO_INBOX_AI_PROVIDER=gemini
EVO_INBOX_AI_MODEL=gemini-3.5-flash
EVO_INBOX_AI_ACTIVE=true

# Knowledge retrieval mode for the seed. `gemini` reuses
# EVO_INBOX_GEMINI_API_KEY for Gemini embeddings. `keyword` keeps semantic
# retrieval disabled until configured in the UI.
EVO_INBOX_EMBEDDINGS_PROVIDER=gemini

# Optional when exactly one Supabase `accounts` row exists; required when there
# are multiple accounts.
# EVO_INBOX_ACCOUNT_ID=

# Optional audit user id; falls back to `accounts.owner_user_id`.
# EVO_INBOX_CONFIG_USER_ID=

# Paste the real Gemini API key only in the VPS `.env.gemini` copy.
EVO_INBOX_GEMINI_API_KEY=paste-real-gemini-key-here

# Optional business-specific instructions shown under the AI setup form.
# EVO_INBOX_AI_SYSTEM_PROMPT=
