# Runtime env for the EVO Inbox companion container.
# Copy to .env.production on the target host and replace placeholders there.
# Do not commit real values.

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_SITE_URL=https://inbox.evoadmissions.com
EVO_INBOX_DOMAIN=inbox.evoadmissions.com
EVO_CADDY_NETWORK=evo_public_web

# Supabase companion project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=<set-on-host>

# 64 hex chars. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# Proof/preflight-only values. The app stores WAHA, amoCRM, and AI provider
# credentials per account in encrypted settings; these values are used by
# `npm run preflight:prod` and the issue #20 proof runbook, not by Next.js
# client code.
EVO_INBOX_WAHA_BASE_URL=http://evo-crm-waha:3000
EVO_INBOX_WAHA_API_KEY=replace-me
EVO_INBOX_WAHA_WEBHOOK_HMAC=replace-me
EVO_INBOX_AMOCRM_BASE_URL=https://example.amocrm.com
EVO_INBOX_AMOCRM_ACCESS_TOKEN=replace-me
# Provide one of these, not both.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EVO_INBOX_TEST_WHATSAPP_NUMBER=15551234567
