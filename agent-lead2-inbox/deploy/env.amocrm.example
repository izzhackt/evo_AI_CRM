# amoCRM production seed env.
# Copy to .env.amocrm on the target host and replace placeholders there.
# Do not commit real values.

# Required: amoCRM/Kommo account URL.
EVO_INBOX_AMOCRM_BASE_URL=https://evoadmissions.amocrm.ru

# Required: long-lived token generated from the EVO Inbox external/private
# integration Keys and scopes tab. This value is validated against
# /api/v4/account, then stored encrypted in Supabase integration_secrets.
EVO_INBOX_AMOCRM_ACCESS_TOKEN=replace-me

# Optional: force new leads into a specific amoCRM pipeline/status/user.
# Leave blank to let amoCRM choose defaults.
EVO_INBOX_AMOCRM_PIPELINE_ID=
EVO_INBOX_AMOCRM_STATUS_ID=
EVO_INBOX_AMOCRM_RESPONSIBLE_USER_ID=

# Optional when exactly one Supabase account exists. Required if multiple
# account rows exist.
EVO_INBOX_ACCOUNT_ID=

# Optional audit user id. Defaults to accounts.owner_user_id.
EVO_INBOX_CONFIG_USER_ID=
