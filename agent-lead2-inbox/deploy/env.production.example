# Runtime env for the EVO Inbox companion container.
# Copy to .env.production on the target host and replace placeholders there.
# Do not commit real values.

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_SITE_URL=https://inbox.evoadmissions.com
EVO_INBOX_DOMAIN=inbox.evoadmissions.com
EVO_CADDY_NETWORK=evo_public_web

# Private P7B readiness is off until its two live dependency probes and the
# separately generated 32..128-byte Inbox-only secret are configured. Never
# reuse a WAHA, webhook, worker, Supabase, Lead Agent or CRM probe secret.
EVO_PLATFORM_P7B_OBSERVABILITY_ENABLED=0
EVO_INBOX_P7B_OBSERVABILITY_SECRET=

# Supabase companion project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=<set-on-host>

# 64 hex chars. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# Shared secret for internal scheduled endpoints such as /api/internal/crm-sync.
# Generate a long random value on the host; never expose it publicly.
AUTOMATION_CRON_SECRET=replace-with-random-cron-secret

# The private WAHA base URL is also used by the server-side readiness probe.
# The app stores WAHA, amoCRM, and AI provider credentials per account in
# encrypted settings; the remaining values below are used by `npm run
# preflight:prod` and the issue #20 proof runbook, not by Next.js client code.
EVO_INBOX_WAHA_BASE_URL=http://evo-inbox-waha:3000
EVO_INBOX_WAHA_API_KEY=replace-me
EVO_INBOX_WAHA_WEBHOOK_HMAC=replace-me
EVO_INBOX_AMOCRM_BASE_URL=https://example.amocrm.com
EVO_INBOX_AMOCRM_ACCESS_TOKEN=replace-me
# Put the real Gemini key in the ignored .env.gemini seed file, not here.
EVO_INBOX_TEST_WHATSAPP_NUMBER=15551234567
