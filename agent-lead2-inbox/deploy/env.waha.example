# Runtime env for the private EVO Inbox WAHA service.
# Copy to .env.waha on the target host and replace placeholders there.
# Do not commit real values.

# Recommended WAHA format: sha512:<sha512 hex of the plain API key>.
# The app stores the plain key only in encrypted Supabase settings and, for the
# issue #20 proof preflight, in .env.production as EVO_INBOX_WAHA_API_KEY.
WAHA_API_KEY=sha512:replace-with-sha512-hash

# Keep WAHA private. Do not publish ports for dashboard/swagger.
WAHA_PRINT_QR=false
WAHA_API_KEY_EXCLUDE_PATH=ping

# Optional dashboard/swagger auth if a private SSH tunnel is used later.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-me
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=replace-me
