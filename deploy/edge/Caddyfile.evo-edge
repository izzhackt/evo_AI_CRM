{
	servers {
		max_header_size 32KB
	}

	# Default logger = everything that has no site-level `log` block, in particular
	# the http.log.error entries ("dial tcp ... no such host" when an upstream is
	# unreachable), which carry the full request: headers and the query string.
	# Strip the Supabase keys there (apikey header, ?apikey= / ?token= /
	# ?access_token= of the realtime websocket) so no key reaches `docker logs`
	# of evo-edge-caddy. Authorization is deleted although Caddy already masks it.
	# ?token_hash= is the one-time token of the student recovery and invitation
	# links (/auth/callback): anyone who could read it here could use the link
	# before the student does. The Referer header repeats it: the sub-requests of
	# the callback page (/_next/static/*, the form post) carry the page URL, because
	# the edge Referrer-Policy of (evo_app) overrides the app's no-referrer.
	log {
		format filter {
			wrap json
			fields {
				request>headers>Apikey delete
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>Referer regexp (token_hash=)[^&#\s]+ ${1}REDACTED
				request>uri query {
					replace apikey REDACTED
					replace access_token REDACTED
					replace token REDACTED
					replace token_hash REDACTED
				}
			}
		}
	}
}

(evo_app) {
	@private path /api/internal /api/internal/* /api/readiness /api/readiness/* /admin /admin/* /metrics /metrics/* /api/public/website-leads /api/public/website-leads/* /api/v2/whatsapp/inbound /api/v2/whatsapp/inbound/*
	respond @private 404

	@health path /api/health
	header @health Cache-Control "no-store"

	header {
		-Server
		Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https://*.supabase.co; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; upgrade-insecure-requests"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# The access log of the CRM and student hosts. The emailed student links open
	# /auth/callback?token_hash=...&type=recovery (or invite): the value is a one-time
	# token that logs must not keep, so the query value is replaced, whatever the path,
	# in the request URI, in the Referer of the page's own sub-requests and in the
	# Location of the app's canonical-host redirect (a student link opened on crm.).
	# The Wazzup webhook address carries its only secret as ?token=<64 hex>
	# (/api/v2/whatsapp/wazzup/inbound, docs/runbooks/wazzup-whatsapp.md): the value is
	# replaced here too, or the token would sit in `docker logs evo-edge-caddy`.
	log {
		format filter {
			request>uri query {
				replace token_hash REDACTED
				replace token REDACTED
			}
			request>headers>Referer regexp (token_hash=)[^&#\s]+ ${1}REDACTED
			resp_headers>Location query {
				replace token_hash REDACTED
			}
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>X-Evo-Observability-Request-Id delete
			request>headers>X-Evo-Observability-Timestamp delete
			request>headers>X-Evo-Observability-Hmac-Algorithm delete
			request>headers>X-Evo-Observability-Hmac delete
			request>headers>X-Api-Key delete
			request>headers>X-Hub-Signature-256 delete
			request>headers>X-Webhook-Hmac delete
			request>headers>X-Webhook-Hmac-Algorithm delete
			request>headers>X-Cron-Secret delete
			request>headers>Idempotency-Key delete
			request>headers>X-Evo-Agent-Admin-Key delete
			request>headers>X-Evo-Agent-Signature delete
			request>headers>X-Evo-Agent-Signature-Algorithm delete
			request>headers>X-Evo-Worker-Hmac delete
			request>headers>X-Evo-Worker-Hmac-Algorithm delete
			request>headers>X-Evo-Autonomous-Reply-Hmac delete
			request>headers>X-Evo-Autonomous-Reply-Hmac-Algorithm delete
			request>headers>X-Evo-Portal-Overdue-Hmac delete
			request>headers>X-Evo-Portal-Overdue-Hmac-Algorithm delete
			request>headers>X-Evo-Gemini-Hmac delete
			request>headers>X-Evo-Gemini-Hmac-Algorithm delete
			request>headers>X-Evo-History-Hmac delete
			request>headers>X-Evo-History-Hmac-Algorithm delete
			request>headers>X-Evo-Media-Hmac delete
			request>headers>X-Evo-Media-Hmac-Algorithm delete
			request>headers>X-Evo-Website-Key delete
			request>headers>X-Evo-Website-Ip delete
		}
	}
}

(evo_canonical_api_paths) {
	# Match the original request URI before an application framework can
	# canonicalize a malformed API request into a different route.
	@reject_noncanonical_api vars_regexp {http.request.orig_uri} `^/api[^?]*(//|\\|%5[cC]|%2[fF]|%2[eE]|/\.\.?(/|$))`
	respond @reject_noncanonical_api 404
}

crm.evoadmissions.com, app.evoadmissions.com {
	import evo_app
	import evo_canonical_api_paths
	request_body {
		max_size 105MB
	}
	encode zstd gzip

	# WhatsApp via Wazzup (docs/EVO_WAZZUP_WHATSAPP_PLAN_2026-10-27.md 5.7). Wazzup posts
	# from the internet, so the path is NOT in @private; it is served only on crm.
	# - app. answers 404 (the app checks Host again);
	# - the body is limited to the same 1 MiB the app enforces;
	# - X-Evo-Wazzup-Ip is OVERWRITTEN with the peer address: the app's failed-token
	#   limiter trusts only this header, never X-Forwarded-For;
	# - while the app container is being replaced (a release) the connection fails and
	#   Wazzup, which probably does not retry, would get a 502: lb_try_duration keeps
	#   the request and retries the connection every 500 ms for up to 25 s (below
	#   Wazzup's 30 s timeout). Caddy retries a POST only when the connection itself
	#   failed (before any byte was sent), which is the case here, so a retry is safe.
	# - the matcher is exact on the ORIGINAL request URI. `handle` runs before the `respond`
	#   guards of this block (evo_canonical_api_paths, @private), and a `path` matcher alone
	#   lower-cases, percent-decodes and dot-cleans the path before comparing, so on its own
	#   it would also take /api/internal/x%2f..%2f..%2fv2/whatsapp/wazzup/inbound and proxy
	#   that raw URI to the app without the guards ever seeing it. With the check on
	#   {http.request.orig_uri} every other spelling falls through to those guards (404) or
	#   to the common proxy below;
	# - request_header drops a client-supplied X-Evo-Wazzup-Ip on every route: only the
	#   handler below sets it, so a spelling that reaches the common proxy cannot bring its
	#   own address into the app's failed-token limiter.
	request_header -X-Evo-Wazzup-Ip
	@wazzup {
		path /api/v2/whatsapp/wazzup/inbound
		vars_regexp {http.request.orig_uri} `^/api/v2/whatsapp/wazzup/inbound(\?|$)`
	}
	handle @wazzup {
		@wazzup_not_crm not host crm.evoadmissions.com
		respond @wazzup_not_crm 404
		request_body {
			max_size 1MiB
		}
		reverse_proxy evo-crm-app:3000 {
			header_up X-Evo-Wazzup-Ip {remote_host}
			lb_try_duration 25s
			lb_try_interval 500ms
		}
	}

	reverse_proxy evo-crm-app:3000 {
		header_up X-Evo-Mcp-Ip {remote_host}
	}
}

# Navigation from the retired technical hostname is not a second app origin.
# In particular, never forward callback/form POSTs across hosts.
(evo_retired_app) {
	header {
		-Server
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}
	route {
		import evo_canonical_api_paths
		@private path /api/internal /api/internal/* /api/readiness /api/readiness/* /admin /admin/* /metrics /metrics/* /api/public/website-leads /api/public/website-leads/*
		respond @private 404
		@mutation not method GET HEAD
		respond @mutation 405
		@student path /portal /portal/* /auth/callback /auth/callback/*
		redir @student https://app.evoadmissions.com{uri} 308
		redir https://crm.evoadmissions.com{uri} 308
	}
}

evo-crm.72.62.119.112.sslip.io {
	import evo_retired_app
}

# Existing VPS routes are intentionally part of the EVO edge source of truth.
# Keep them when reconciling the live, locally edited Caddyfile.
# OlympiadAI LMS: maintained in /opt/olympiadai-lms
olympiadai.72.62.119.112.sslip.io {
  encode zstd gzip
  request_body {
    max_size 21MB
  }
  reverse_proxy olympiadai-lms:3000
  header {
    Strict-Transport-Security "max-age=31536000"
    -Server
  }
}

(evo_website) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
	}
	route {
		import evo_canonical_api_paths
		@website_intake {
			method POST
			path /api/website-leads
		}
		handle @website_intake {
			request_body {
				max_size 8KB
			}
			reverse_proxy evo-crm-app:3000 {
				rewrite /api/public/website-leads
				header_up -Cookie
				header_up -Authorization
				header_up -Proxy-Authorization
				header_up X-EVO-Website-IP {remote_host}
				# Required private file in the existing persistent Caddy data volume.
				# It overwrites X-EVO-Website-Key; never put the real value in Git.
				import /data/evo-website/intake-header.caddy
			}
		}
		handle /api/website-leads {
			header Allow "POST"
			respond 405
		}
		@website_api path /api /api/*
		handle @website_api {
			respond 404
		}
		handle {
			reverse_proxy evo-website-web:8080
		}
	}
}

# www is only a redirect to the apex (308 keeps the method).
www.evoadmissions.com {
	redir https://evoadmissions.com{uri} 308
}

evoadmissions.com {
	import evo_website
}

# Self-hosted Supabase (EVO). Only the four public API families reach the
# gateway; Studio, /pg (meta), analytics, functions and everything else is 404.
# evo-supabase-gw is the alias the gateway container carries on evo_public_web.
# No access log, so apikey/Authorization and the websocket apikey query string
# are not logged per request. The error log (gateway unreachable) goes through
# the default logger, whose filter in the global block above strips the apikey
# header and the apikey/token/access_token query parameters. WebSocket
# (realtime) is proxied by reverse_proxy.
supabase.evoadmissions.com {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}

	@api path /auth/v1/* /rest/v1/* /storage/v1/* /realtime/v1/*
	handle @api {
		reverse_proxy evo-supabase-gw:8000
	}

	handle {
		respond 404
	}
}

# Sales assistant (Messi_InSales): maintained in /opt/sales-assistant
# Site block for the shared edge proxy on hermes (container evo-edge-caddy). Not imported
# automatically: the owner appends it to the edge Caddyfile (README, "Deploy on hermes").
# The api container joins evo_public_web as sales-assistant-api and trusts proxy headers
# only from that network. The app sets its own CSP, X-Frame-Options, Referrer-Policy and
# Permissions-Policy; the edge adds HSTS and hides its Server header. No access log:
# guest chat URLs (/chat/<token>) are capability links.
# SoodaCloser (maintained by the soodacloser repo; landing in /opt/soodacloser-landing, app in /opt/sales-assistant).
# soodacloser.com serves the landing for its own paths; every other path (the app, /chat/<token>
# client links, /api/*, /static/*) moves to app.soodacloser.com with a 308, which keeps the method.
soodacloser.com {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}

	@landing path / /en /en/ /404.html /_astro/* /favicon.svg /favicon-32.png /apple-touch-icon.png /og.png /api/demo-request
	handle @landing {
		request_body {
			max_size 64KiB
		}
		reverse_proxy soodacloser-landing:8790
	}

	handle {
		redir https://app.soodacloser.com{uri} 308
	}
}

# The app (was soodacloser.com until the landing took the apex).
app.soodacloser.com {
	# App limit: 26 MiB per request (25 MB document + multipart overhead).
	request_body {
		max_size 26MiB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}

	# SSE (answer preparation): no compression, every event passed through immediately.
	@advice_stream path_regexp advice_stream ^/api/rooms/[^/]+/advice/stream$
	handle @advice_stream {
		reverse_proxy sales-assistant-api:8781 {
			flush_interval -1
			transport http {
				read_timeout 5m
			}
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy sales-assistant-api:8781 {
			flush_interval -1
			transport http {
				read_timeout 5m
			}
		}
	}
}

# www is only a redirect to the apex.
www.soodacloser.com {
	redir https://soodacloser.com{uri} permanent
}
