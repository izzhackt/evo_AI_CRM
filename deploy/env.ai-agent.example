# «ИИ-агент» runtime environment: names only, never values.
# On hermes the owner creates /opt/evo-crm/.env.ai-agent (root:root, mode 0600) from this
# list; the real file never enters Git, chat, logs or the CRM database. The values also live
# in the SOPS archive «Секреты и доступы ЭВО». Runbook: docs/runbooks/ai-agent-enable.md.
# The release controller refuses an enabled release when the file is missing, is not 0600,
# or lacks a non-empty value for any of the first three names.
# Compose reads this file in raw format: one NAME=value per line, the value taken literally.
# No `export`, no quotes around a value, no blanks around it (the controller refuses them);
# `$` and `#` inside a value are kept as they are.
# Names: the private service's settings (evo-ai-agent `evo_ai_agent/config.py`,
# `evo_ai_agent/assistant/settings.py`, `evo_ai_agent/ingest/arbiter.py`, read at p4-night
# 69fcb2a, 07.10.2026). Every name has the prefix EVO_AI_AGENT_; the service ignores others.

# --- P1: required for an enabled release ------------------------------------------------
# Gemini key of EVO's Google Cloud project, restricted to the Generative Language API.
# Only the agent reads it; the CRM never has it.
EVO_AI_AGENT_GEMINI_API_KEY=
# postgresql://evo_ai_agent.<project_ref>:<password>@<supavisor-host>:6543/postgres
# (transaction mode; the role's LOGIN password is set outside Git and is hex only,
# `openssl rand -hex 32`, so it never needs URL escaping).
EVO_AI_AGENT_DATABASE_URL=
# HMAC of CRM -> agent requests. The same value goes into /opt/evo-crm/.env.production;
# it is not a WAHA or lead-agent secret. 32–256 printable characters, `openssl rand -hex 32`.
EVO_AI_AGENT_INTERNAL_SECRET=

# --- P2: document upload («Информация для агента», «Лист сверки», «Лаборатория») ----------
# HMAC of the CRM storage broker /api/internal/ai-agent/storage/* (plan §4.5): the agent's
# only way to originals, page images and review crops. Its own value, distinct from
# INTERNAL_SECRET and SEND_SECRET; the same value goes into /opt/evo-crm/.env.production.
# Empty: P1 works, uploaded files wait in the queue and never reach `ready`.
EVO_AI_AGENT_STORAGE_SECRET=

# --- P3: client memory — no names of its own (an admin switch in «Агент и лимит») ---------

# --- P4: night autoresponder (plan §11, ADR 0031) -------------------------------------------
# HMAC of the agent -> CRM send route POST /api/internal/ai-agent/send (body exactly
# {"decisionId": ...}). Its own value, distinct from both other agent secrets; the same value
# goes into /opt/evo-crm/.env.production. Empty: the agent never calls the route and a live
# decision pauses the autoresponder (`server_switch_off`). Shadow nights need no send.
EVO_AI_AGENT_SEND_SECRET=
# The agent's half of the global switch; the CRM reads its own EVO_AI_AGENT_AUTOSEND in
# .env.production. Only 1 in BOTH files lets a scheduled live answer reach the send route;
# '' or 0 (the default) pauses the autoresponder instead. Stays 0: 1 only with the owner's
# separate permission for a P4 rollout step (runbook, «Порядок включения»).
EVO_AI_AGENT_AUTOSEND=0

# --- Optional tuning: the defaults are the reviewed values; set one only with a reason -----
# CRM app on the private network evo_crm_ai that serves the storage broker and the send route
# (never a public URL).
# EVO_AI_AGENT_CRM_BASE_URL=http://evo-crm-app:3000
# Database pool per process (the role has CONNECTION LIMIT 10: 2 api workers x 3 + 1 worker x 2).
# EVO_AI_AGENT_DB_POOL_MIN=1
# EVO_AI_AGENT_DB_POOL_MAX_API=3
# EVO_AI_AGENT_DB_POOL_MAX_WORKER=2
# EVO_AI_AGENT_DB_CONNECT_TIMEOUT=10
# EVO_AI_AGENT_DB_CALL_TIMEOUT=20
# Gemini transport and the query-vector cache.
# EVO_AI_AGENT_GEMINI_TIMEOUT=60
# EVO_AI_AGENT_GEMINI_MAX_ATTEMPTS=4
# EVO_AI_AGENT_GEMINI_MAX_CONCURRENCY=8
# EVO_AI_AGENT_EMBEDDING_CACHE_SIZE=2048
# Answer: hedged stream after N s without text (0 = off), deadlines in seconds, passage limits.
# EVO_AI_AGENT_FIRST_TOKEN_HEDGE_S=4
# EVO_AI_AGENT_GENERATION_DEADLINE_S=30
# EVO_AI_AGENT_REWRITE_TIMEOUT_S=2.5
# EVO_AI_AGENT_EMBED_TIMEOUT_S=3
# EVO_AI_AGENT_COVERAGE_CHECK_TIMEOUT_S=6
# EVO_AI_AGENT_SEARCH_CLIENT_LIMIT=8
# EVO_AI_AGENT_SEARCH_INTERNAL_LIMIT=3
# EVO_AI_AGENT_MAX_SUBQUERIES=3
# Only `off`: no reranker is deployed (plan §4.2).
# EVO_AI_AGENT_RERANK_MODE=off
# Allowed clock difference of signed CRM <-> agent requests, seconds.
# EVO_AI_AGENT_CLOCK_SKEW_SECONDS=60
# P2 storage broker and ingest (plan §4.8): broker timeout and attempts, the sandbox child's
# limits, a whole upload run's deadline, OCR/vision pages in flight, pages per budget reservation.
# EVO_AI_AGENT_BROKER_TIMEOUT=60
# EVO_AI_AGENT_BROKER_MAX_ATTEMPTS=3
# EVO_AI_AGENT_INGEST_EXTRACT_TIMEOUT_SECONDS=120
# EVO_AI_AGENT_INGEST_EXTRACT_MEMORY_MB=768
# EVO_AI_AGENT_INGEST_DEADLINE_SECONDS=7200
# EVO_AI_AGENT_OCR_CONCURRENCY=1
# EVO_AI_AGENT_VISION_CONCURRENCY=2
# EVO_AI_AGENT_INGEST_BUDGET_PAGES=10
# P2 digit arbiter: parallel calls and per-model requests per minute.
# EVO_AI_AGENT_ARBITER_CONCURRENCY=4
# EVO_AI_AGENT_ARBITER_PRO_RPM=20
# EVO_AI_AGENT_ARBITER_FLASH_RPM=120
# Worker queue (WORKER_REF defaults to host:pid) and maintenance.
# EVO_AI_AGENT_WORKER_POLL_SECONDS=2
# EVO_AI_AGENT_WORKER_VISIBILITY_SECONDS=120
# EVO_AI_AGENT_WORKER_REF=
# EVO_AI_AGENT_MAINTENANCE_INTERVAL_SECONDS=3600
# P3 memory: how often the worker asks for new inbound messages, seconds.
# EVO_AI_AGENT_MEMORY_POLL_SECONDS=5
# P4: morning summary poll, seconds; send route timeout, seconds (at least 60).
# EVO_AI_AGENT_AUTOSEND_SUMMARY_POLL_SECONDS=60
# EVO_AI_AGENT_AUTOSEND_SEND_TIMEOUT=90
# EVO_AI_AGENT_LOG_LEVEL=INFO
