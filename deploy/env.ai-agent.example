# «ИИ-агент» runtime environment: names only, never values.
# On hermes the owner creates /opt/evo-crm/.env.ai-agent (root:root, mode 0600) from this
# list; the real file never enters Git, chat, logs or the CRM database. The values also live
# in the SOPS archive «Секреты и доступы ЭВО». Runbook: docs/runbooks/ai-agent-enable.md.
# The release controller refuses an enabled release when the file is missing, is not 0600,
# or lacks a non-empty value for any of the first three names.
# Compose reads this file in raw format: one NAME=value per line, the value taken literally.
# No `export`, no quotes around a value, no blanks around it (the controller refuses them);
# `$` and `#` inside a value are kept as they are.

# Gemini key of EVO's Google Cloud project, restricted to the Generative Language API.
EVO_AI_AGENT_GEMINI_API_KEY=
# postgresql://evo_ai_agent.<project_ref>:<password>@<supavisor-host>:6543/postgres
# (transaction mode; the role's LOGIN password is set outside Git and is hex only,
# `openssl rand -hex 32`, so it never needs URL escaping).
EVO_AI_AGENT_DATABASE_URL=
# HMAC of CRM -> agent requests. The same value goes into /opt/evo-crm/.env.production;
# it is not a WAHA or lead-agent secret.
EVO_AI_AGENT_INTERNAL_SECRET=
# CRM storage broker (P2). Unused in P1; leave empty until P2.
EVO_AI_AGENT_STORAGE_SECRET=

# Optional tuning; the defaults are the reviewed values (plan §4.4, §6.9).
# EVO_AI_AGENT_DB_POOL_MIN=1
# EVO_AI_AGENT_DB_POOL_MAX_API=3
# EVO_AI_AGENT_DB_POOL_MAX_WORKER=2
# EVO_AI_AGENT_LOG_LEVEL=INFO
