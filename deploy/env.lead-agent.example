# Copy this file to /opt/evo-crm/.env.lead-agent on the VPS and replace values.
# Never commit the real .env.lead-agent file.

# WAHA private API. Plain key must match the hash stored in .env.waha.
EVO_AGENT_WAHA_API_KEY=
EVO_AGENT_WAHA_SESSION=crm_primary
EVO_AGENT_WAHA_WEBHOOK_SECRET=
EVO_AGENT_WAHA_WEBHOOK_URL=http://evo-lead-agent:8000/webhooks/waha

# Receive-only rollout safety.
# Autoreply means Gemini draft review is generated inside the agent pipeline.
# Outbound must stay false until a later explicitly approved send test.
EVO_AGENT_AUTOREPLY_ENABLED=true
EVO_AGENT_OUTBOUND_ENABLED=false

# amoCRM source of truth.
EVO_AGENT_AMO_BASE_URL=https://example.amocrm.ru
EVO_AGENT_AMO_CLIENT_ID=
EVO_AGENT_AMO_CLIENT_SECRET=
EVO_AGENT_AMO_REDIRECT_URI=
EVO_AGENT_AMO_REFRESH_TOKEN=
EVO_AGENT_AMO_TOKEN_FILE=/app/data/amo-token.json
EVO_AGENT_AMO_PIPELINE_ID=
EVO_AGENT_AMO_STATUS_ID=
EVO_AGENT_AMO_RESPONSIBLE_USER_ID=

# Must match CRM Settings -> lead-agent sync secret.
EVO_AGENT_CRM_SYNC_SECRET=

# Private admin API for knowledge imports. Never expose publicly.
EVO_AGENT_ADMIN_API_KEY=

# Gemini draft review.
# GEMINI_API_KEY is the rollout default; GOOGLE_API_KEY and
# EVO_AGENT_GEMINI_API_KEY are accepted by the lead-agent for operator recovery.
GEMINI_API_KEY=
EVO_AGENT_GEMINI_MODEL=gemini-3.5-flash
