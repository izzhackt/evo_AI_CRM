# Copy this file to /opt/evo-crm/.env.production on the VPS and replace values.
# Never commit a real .env.production file.

EVO_CRM_DOMAIN=crm.evoadmissions.com
EVO_CADDY_NETWORK=evo_public_web

# Browser code receives only the Supabase URL and publishable key. The secret
# key and canonical organization UUID are mandatory server-only inputs and
# must never use NEXT_PUBLIC_*.
# With the repository variable EVO_SUPABASE_TARGET=selfhosted the only accepted
# URL is exactly https://supabase.evoadmissions.com and the keys come from that
# stack (docs/runbooks/selfhosted-cutover.md).
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-dedicated-platform-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
EVO_PLATFORM_SUPABASE_SECRET_KEY=replace-with-production-secret-key
EVO_PLATFORM_ORGANIZATION_ID=replace-with-production-organization-uuid

# Optional short staff login. Still requires the real Supabase password and
# verified Admin authority. Configure only the owner's existing Admin email.
EVO_STAFF_ADMIN_LOGIN_EMAIL=

# P5 receive-only Platform WAHA ingress remains disabled until a separately
# authorized private webhook cutover. EVO_PLATFORM_WAHA_INGRESS_ENABLED is the
# runtime switch: the inbound route answers 503 and does nothing unless it is
# exactly 1, even when the secret below is already set (a staged setup is
# valid), and Settings and the WhatsApp page say «Приём сообщений выключен на
# сервере» while it is 0. Inject real backend-only values at deployment time;
# never use NEXT_PUBLIC_* for these secrets.
EVO_PLATFORM_WAHA_INGRESS_ENABLED=0
EVO_PLATFORM_WAHA_WEBHOOK_HMAC_SECRET=
# UUID of the staff membership that owns new inbound WhatsApp conversations; it
# must be eligible as a sales intake owner. Required (non-empty) when
# EVO_PLATFORM_WAHA_INGRESS_ENABLED=1.
EVO_PLATFORM_WAHA_INTAKE_SALES_MEMBERSHIP_ID=

# P7B private CRM readiness and Prometheus metrics. Inject a distinct
# backend-only 32-128-byte signature secret only when enabling the feature.
EVO_PLATFORM_P7B_OBSERVABILITY_ENABLED=0
EVO_PLATFORM_P7B_OBSERVABILITY_SECRET=

# «ИИ-агент» (docs/EVO_AI_AGENT_PLAN_2026-10-06.md §4.3, §4.7). OPTIONAL: a
# release without this name or with it empty is valid and the AI window says
# «ИИ-агент не подключён к CRM». The same value lives in /opt/evo-crm/.env.ai-agent
# for the private agent; 32–256 printable characters, distinct from every WAHA
# and lead-agent secret. The CRM calls only http://evo-ai-agent:8080 on
# evo_crm_ai (the agent's own network, joined by the app only while the agent is
# enabled); the browser never reaches the agent. Which name in which file and the
# enabling order P1–P4 (owner vs operator): docs/runbooks/ai-agent-enable.md.
EVO_AI_AGENT_INTERNAL_SECRET=

# «ИИ-агент» P2 storage broker (plan §4.5). OPTIONAL: without it the internal
# route /api/internal/ai-agent/storage/* answers 503 and uploaded files wait in
# the queue. The agent signs its GET/PUT of originals, page images and crops
# with this value (also in /opt/evo-crm/.env.ai-agent); 32–256 printable
# characters, distinct from EVO_AI_AGENT_INTERNAL_SECRET and every other value.
EVO_AI_AGENT_STORAGE_SECRET=

# «ИИ-агент» P4 night autoresponder (plan §11; ADR 0031). OPTIONAL and OFF:
# EVO_AI_AGENT_AUTOSEND is the server switch of /api/internal/ai-agent/send —
# anything but exactly 1 answers 503 and makes no database or WhatsApp call;
# only '', 0 or 1 release, and 1 needs EVO_AI_AGENT_INTERNAL_SECRET and
# EVO_AI_AGENT_SEND_SECRET. Turn it on only with the owner's separate permission
# for a P4 rollout step; 0 is the instant global stop. The agent signs each send
# with EVO_AI_AGENT_SEND_SECRET (also in /opt/evo-crm/.env.ai-agent); 32–256
# printable characters, distinct from both other agent secrets and every value.
EVO_AI_AGENT_AUTOSEND=0
EVO_AI_AGENT_SEND_SECRET=

# Beeline KG PBX telephony (docs/EVO_TELEPHONY_PLAN_2026-10-16.md §5.1, §5.5;
# ADR 0033). OPTIONAL: a release without these names or with them empty is valid
# and everything telephony stays off. EVO_PLATFORM_TELEPHONY_ENABLED is the
# intake switch: anything but exactly 1 makes POST
# /api/v2/telephony/beeline/inbound answer 503 for event, history and rating and
# store nothing (the PBX command «contact» is answered 200 {} regardless, with no
# database access). Only '', 0 or 1 release, and 1 needs
# EVO_PLATFORM_TELEPHONY_CRM_TOKEN. HARD precondition: it is not set to 1 in any
# environment until main carries the phone-erasure mechanism (docs/PLAN_CHANGES.md,
# «Телефония T1a: схема и RLS», item 20): either the controlled T11 cleanup of
# telephony_pbx_events with the append-only lock replaced, or a keyed or masked
# phone column on the evidence. Until then it stays 0.
# - CRM_TOKEN: the «Ключ для авторизации в вашей CRM» typed into the cabinet
#   connection; the PBX sends it as crm_token. 32-64 characters from [A-Za-z0-9-]
#   (a UUID or 64 hex), distinct from every other value.
# - CRM_TOKEN_NEXT: only while the key is being rotated (both are accepted).
# - PBX_TOKEN, PBX_URL, PBX_HOST: the outbound group (key from the cabinet, API
#   base https://<tenant>/crmapi/v1 without a trailing slash, tenant host).
#   All three or none. The background job /app/telephony-maintenance.mjs (host
#   timer deploy/telephony/, plan 5.3) reads them for the user directory, the
#   facts probe and the history reconciliation; it needs ENABLED=1 as well and
#   stays idle without the group. The API host must be the tenant host or a name
#   under ats.beeline.kg.
# Real values live only in /opt/evo-crm/.env.production and the SOPS archive.
EVO_PLATFORM_TELEPHONY_ENABLED=0
EVO_PLATFORM_TELEPHONY_CRM_TOKEN=
EVO_PLATFORM_TELEPHONY_CRM_TOKEN_NEXT=
EVO_PLATFORM_TELEPHONY_PBX_TOKEN=
EVO_PLATFORM_TELEPHONY_PBX_URL=
EVO_PLATFORM_TELEPHONY_PBX_HOST=

# WhatsApp via Wazzup (docs/EVO_WAZZUP_WHATSAPP_PLAN_2026-10-27.md §5.1, §5.5, §9;
# docs/runbooks/wazzup-whatsapp.md). OPTIONAL: a release without these names or with
# them empty is valid and the Wazzup receive path stays off.
# - EVO_PLATFORM_WAZZUP_INGRESS_ENABLED: the EMERGENCY STOP of POST
#   /api/v2/whatsapp/wazzup/inbound: anything but exactly 1 answers 503 and does
#   nothing. It only says «receive allowed»; the working switch is the database
#   transport (`wazzup-ops transport wazzup`, no release needed). Only '', 0 or 1
#   release; 1 needs the token below and EVO_PLATFORM_WAHA_INTAKE_SALES_MEMBERSHIP_ID.
#   HARD rule: it is never 1 together with EVO_PLATFORM_WAHA_INGRESS_ENABLED=1 (two
#   receive paths for one number store every message twice); the contract refuses it.
#   Changing it is a release (a plain container restart does not re-read the file).
# - EVO_PLATFORM_WAZZUP_WEBHOOK_TOKEN: the secret of the webhook address (?token=),
#   exactly 64 hex characters, created on the server (`openssl rand -hex 32`, never
#   printed) and distinct from every other value. _NEXT only while it is being
#   rotated (both are accepted).
# The Wazzup API key is NOT here: it lives in the Supabase Vault and is set with
# `wazzup-ops set-key` (key on stdin, never in argv, a file or this env file).
EVO_PLATFORM_WAZZUP_INGRESS_ENABLED=0
EVO_PLATFORM_WAZZUP_WEBHOOK_TOKEN=
EVO_PLATFORM_WAZZUP_WEBHOOK_TOKEN_NEXT=

# «ИИ-агенты» на Claude Managed Agents (docs/design/ai-agents/contract.md §C.6,
# docs/runbooks/ai-agents-managed.md; ADR 0035). OPTIONAL: a release without these
# names or with them empty is valid and the whole section stays off ("ключ Claude
# API не задан"). Real values live only in /opt/evo-crm/.env.production and the
# SOPS archive — never in Git or chat. Spend limits are set by the owner in the
# Claude Console, not here.
# - EVO_ANTHROPIC_API_KEY: the Claude API key of the Console workspace. 20-300
#   printable characters, distinct from every other value in this file (it is a
#   different secret from the legacy ANTHROPIC_API_KEY below). Emptying it is the
#   instant global stop for runs, schedules and events.
# - EVO_ANTHROPIC_API_BASE_URL: only for a gateway/proxy; https, no path. Empty =
#   https://api.anthropic.com.
# - EVO_AI_AGENTS_MCP_URL: the public MCP address Claude calls. https, path
#   /api/mcp/v1, no trailing slash. Empty = https://crm.evoadmissions.com/api/mcp/v1.
# - EVO_AI_AGENTS_MCP_IP_ALLOWLIST: comma-separated CIDRs/addresses allowed to call
#   the MCP endpoint and to download the one-time document links the agents get
#   (a foreign address gets an empty 404), or `off` (temporary bypass if Anthropic's egress range does
#   not cover Managed Agents; the token stays the main protection). Empty =
#   160.79.104.0/21.
# - EVO_AI_AGENTS_RUN_BUDGET_USD: default spend ceiling of one agent run, USD
#   0..100 (0 = no per-run ceiling). A per-agent value set in the CRM wins. Empty = 5.
# - EVO_AI_AGENT_WHATSAPP_DAILY_BUDGET_USD: daily spend limit of one agent for runs started by an
#   incoming WhatsApp message, USD, above 0 and up to 1000; the day is the Asia/Bishkek calendar day.
#   Zero, a negative number or text is rejected here (and falls back to 10 at runtime): this name
#   never means "unlimited". Empty = 10. Needs migration 322 applied first.
EVO_ANTHROPIC_API_KEY=
EVO_ANTHROPIC_API_BASE_URL=
EVO_AI_AGENTS_MCP_URL=
EVO_AI_AGENTS_MCP_IP_ALLOWLIST=
EVO_AI_AGENTS_RUN_BUDGET_USD=
EVO_AI_AGENT_WHATSAPP_DAILY_BUDGET_USD=

ANTHROPIC_API_KEY=
ZAI_API_KEY=
NEXT_PUBLIC_TRANSCRIPTION_SPLINE_SCENE_URL=
EVO_ENABLE_LOCAL_TRANSCRIPTION=0
