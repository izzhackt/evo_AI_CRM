# Copy this file to /opt/evo-crm/.env.production on the VPS and replace values.
# Never commit a real .env.production file.

EVO_CRM_DOMAIN=crm.evoadmissions.com
EVO_CADDY_NETWORK=acadis_acadis_web

AUTH_SECRET=replace-with-openssl-rand-base64-48
EVO_SECRET_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
EVO_DB_PATH=/app/data/edu-admin.db
EVO_BACKUP_DIR=/app/backups
EVO_ALLOW_DEMO_SEED=0

ANTHROPIC_API_KEY=
ZAI_API_KEY=
NEXT_PUBLIC_TRANSCRIPTION_SPLINE_SCENE_URL=
EVO_ENABLE_LOCAL_TRANSCRIPTION=0
