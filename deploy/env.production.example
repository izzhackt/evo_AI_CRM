# Copy this file to /opt/evo-crm/.env.production on the VPS and replace values.
# Never commit a real .env.production file.

EVO_CRM_DOMAIN=crm.evoadmissions.com
EVO_CADDY_NETWORK=evo_public_web

# Greenfield Platform uses only the publishable key in the web runtime.
# Secret/service-role keys are backend-only and must not use NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-dedicated-platform-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
EVO_UI_CONTRACT_FIXTURES=0

# The following variables remain for the separate legacy CRM runtime. They are
# not a migration, identity bridge or fallback for greenfield Platform Auth.
AUTH_SECRET=replace-with-openssl-rand-base64-48
EVO_SECRET_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
EVO_DB_PATH=/app/data/edu-admin.db
EVO_BACKUP_DIR=/app/backups
EVO_ALLOW_DEMO_SEED=0

ANTHROPIC_API_KEY=
ZAI_API_KEY=
NEXT_PUBLIC_TRANSCRIPTION_SPLINE_SCENE_URL=
EVO_ENABLE_LOCAL_TRANSCRIPTION=0
