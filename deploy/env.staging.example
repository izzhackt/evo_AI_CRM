# Copy this file to /opt/evo-crm-staging/.env.staging on the VPS and replace
# placeholders through the approved staging release procedure. Never commit
# the resulting real file or reuse production credentials here.

EVO_CRM_DOMAIN=staging.crm.evoadmissions.com
EVO_CADDY_NETWORK=evo_public_web

# The staging Supabase project/branch must be separate from production and
# start without production customer data. The publishable key is safe for the
# browser; the secret key below remains server-only. Controlled preflight binds
# this URL, both key fingerprints and the tenant UUID to the protected staging
# Environment before any deployment.
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-isolated-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key
EVO_PLATFORM_SUPABASE_SECRET_KEY=replace-with-staging-secret-key
EVO_PLATFORM_ORGANIZATION_ID=replace-with-staging-organization-uuid
EVO_UI_CONTRACT_FIXTURES=0

# Staging starts receive-only. No WhatsApp provider, worker, autonomous reply,
# amoCRM write, or outbound send is authorized by this template.
EVO_PLATFORM_WAHA_INGRESS_ENABLED=0
EVO_PLATFORM_WAHA_WEBHOOK_HMAC_SECRET=
EVO_PLATFORM_WAHA_WORKER_ENABLED=0
EVO_PLATFORM_WAHA_INTAKE_SALES_MEMBERSHIP_ID=
EVO_PLATFORM_LEAD_AGENT_SYNC_ENABLED=0
EVO_PLATFORM_WAHA_WORKER_TRIGGER_SECRET=
EVO_PLATFORM_WAHA_HISTORY_ENABLED=0
EVO_PLATFORM_WAHA_HISTORY_BASE_URL=
EVO_PLATFORM_WAHA_HISTORY_API_KEY=
EVO_PLATFORM_WAHA_HISTORY_TRIGGER_SECRET=
EVO_PLATFORM_WAHA_MEDIA_ENABLED=0
EVO_PLATFORM_WAHA_MEDIA_BASE_URL=
EVO_PLATFORM_WAHA_MEDIA_API_KEY=
EVO_PLATFORM_WAHA_MEDIA_TRIGGER_SECRET=
EVO_PLATFORM_MANUAL_SEND_WORKER_ENABLED=0
EVO_PLATFORM_MANUAL_SEND_TRIGGER_SECRET=
EVO_LEAD_AGENT_SYNC_SECRET=

# The private readiness endpoint is expected in staging, but remains fail-closed
# until a distinct 32-128 byte staging signature secret is injected.
EVO_PLATFORM_P7B_OBSERVABILITY_ENABLED=1
EVO_PLATFORM_P7B_OBSERVABILITY_SECRET=

# The Admin operations screen may read only this read-only, staging-owned
# recovery result. The host path is mounted at /app/recovery-evidence.
EVO_PLATFORM_U11_RECOVERY_EVIDENCE_ROOT=/app/recovery-evidence
EVO_PLATFORM_U11_RECOVERY_EVIDENCE_PATH=/app/recovery-evidence/u11-recovery-result.json

# Optional integrations stay disabled until each one is separately approved
# and configured with staging-only credentials.
EVO_PLATFORM_AMOCRM_READ_ENABLED=0
EVO_PLATFORM_AMOCRM_ACCOUNT_DOMAIN=
EVO_PLATFORM_AMOCRM_READ_TOKEN=
EVO_PLATFORM_AI_MEMORY_ENABLED=0
EVO_PLATFORM_STAFF_ASSISTANT_ENABLED=0
EVO_PLATFORM_KNOWLEDGE_ACCOUNT_ID=
EVO_PLATFORM_GEMINI_API_KEY=
EVO_PLATFORM_GEMINI_PROPOSALS_ENABLED=0

# Legacy local-runtime values remain isolated in staging-owned volumes.
AUTH_SECRET=
EVO_SECRET_ENCRYPTION_KEY=
EVO_DB_PATH=/app/data/edu-admin.db
EVO_BACKUP_DIR=/app/backups
EVO_ALLOW_DEMO_SEED=0

ANTHROPIC_API_KEY=
ZAI_API_KEY=
ZAI_CODING_PLAN_API_KEY=
ZAI_CODING_PLAN_BASE_URL=
NEXT_PUBLIC_TRANSCRIPTION_SPLINE_SCENE_URL=
EVO_ENABLE_LOCAL_TRANSCRIPTION=0
EVO_ENABLE_EXTERNAL_TRANSCRIPT_IMPROVEMENT=0
