# Copy this file to /opt/evo-crm/.env.waha on the VPS and replace values.
# Never commit the real .env.waha file.

# Store only the SHA-512 hash here. The plain API key belongs in encrypted CRM
# settings so the app can call WAHA server-side.
WAHA_API_KEY=sha512:replace-with-sha512-hash-of-generated-waha-api-key
WAHA_API_KEY_EXCLUDE_PATH=ping
WAHA_PRINT_QR=false

WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-random-password
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=replace-with-random-password
