{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoadmissions.com/schemas/p8-candidate-manifest.schema.json",
  "title": "EVO P8 candidate manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_commit", "candidate_commit", "evidence_index", "generated_at", "images", "runtime_settings", "schema_version"],
  "properties": {
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "evidence_index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "evidence-index.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "image-identity.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "runtime_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "runtime-setting-inventory.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "schema_version": { "const": 1 }
  }
}
