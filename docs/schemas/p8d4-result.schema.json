{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoadmissions.com/schemas/p8d4-result.schema.json",
  "title": "EVO P8D4 redacted result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_code", "candidate", "migrations", "bundles", "images", "containers_before", "containers_after", "rollback", "pilot"],
  "properties": {
    "schema_version": { "const": "p8d4-v1" },
    "result_code": {
      "enum": ["pilot_verified", "preflight_blocked", "build_failed", "migration_failed", "knowledge_failed", "deployment_failed", "pilot_failed", "rollback_failed"]
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["source_commit", "tree", "ci_run", "platform"],
      "properties": {
        "source_commit": { "const": "472cc58115b7e6a459d089fd082081fa8da15610" },
        "tree": { "const": "afadf3248ff696c0cf70388cfe06a9b5a8eebc22" },
        "ci_run": { "const": 31897719155 },
        "platform": { "const": "linux/amd64" }
      }
    },
    "migrations": {
      "type": "object", "additionalProperties": false,
      "required": ["before", "after", "status"],
      "properties": {
        "before": { "type": "string", "pattern": "^001-[0-9]{3}$" },
        "after": { "enum": ["001-075", null] },
        "status": { "enum": ["verified", "not_run", "failed"] }
      }
    },
    "bundles": {
      "type": "array", "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["audience", "bundle_sha256", "document_count", "chunk_count", "status"],
        "properties": {
          "audience": { "enum": ["client", "internal"] },
          "bundle_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "document_count": { "type": ["integer", "null"], "minimum": 0 },
          "chunk_count": { "type": ["integer", "null"], "minimum": 0 },
          "status": { "enum": ["verified", "not_run", "failed"] }
        }
      }
    },
    "images": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "image_id", "status"],
        "properties": {
          "name": { "enum": ["main_crm", "evo_inbox", "lead_agent"] },
          "image_id": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
          "status": { "enum": ["verified", "not_run", "failed", "rolled_back"] }
        }
      }
    },
    "containers_before": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "healthy", "restart_count", "status"],
        "properties": {
          "name": { "enum": ["evo-inbox-app-1", "evo-crm-app-1", "evo-crm-lead-agent-1", "evo-crm-waha-1", "evo-inbox-waha"] },
          "healthy": { "type": ["boolean", "null"] },
          "restart_count": { "type": ["integer", "null"], "minimum": 0 },
          "status": { "enum": ["verified", "not_run", "failed", "rolled_back"] }
        }
      }
    },
    "containers_after": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "healthy", "restart_count", "status"],
        "properties": {
          "name": { "enum": ["evo-inbox-app-1", "evo-crm-app-1", "evo-crm-lead-agent-1", "evo-crm-waha-1", "evo-inbox-waha"] },
          "healthy": { "type": ["boolean", "null"] },
          "restart_count": { "type": ["integer", "null"], "minimum": 0 },
          "status": { "enum": ["verified", "not_run", "failed", "rolled_back"] }
        }
      }
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["images", "env_files", "compose_files", "status"],
      "properties": {
        "images": { "type": "array", "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["name", "sha256"], "properties": { "name": { "enum": ["prior-crm.tar", "prior-inbox.tar", "prior-lead-agent.tar"] }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } },
        "env_files": { "type": "array", "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["name", "sha256"], "properties": { "name": { "enum": ["crm.env.production", "inbox.env.production", "lead-agent.env.production"] }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } },
        "compose_files": { "type": "array", "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["name", "sha256"], "properties": { "name": { "enum": ["crm.compose.yml", "inbox.compose.yml", "lead-agent.compose.yml"] }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } },
        "status": { "enum": ["verified", "not_run", "failed"] }
      }
    },
    "pilot": {
      "type": "array", "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "audience", "http_status", "expected_source_match", "cross_audience_sources", "audit_body_free", "status"],
        "properties": {
          "case_id": { "enum": ["client_china_documents", "internal_malaysia_handoff"] },
          "audience": { "enum": ["client", "internal"] },
          "http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
          "expected_source_match": { "type": ["boolean", "null"] },
          "cross_audience_sources": { "type": ["integer", "null"], "minimum": 0 },
          "audit_body_free": { "type": ["boolean", "null"] },
          "status": { "enum": ["verified", "not_run", "failed"] }
        }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "result_code": { "const": "pilot_verified" } } },
    "then": {
      "properties": {
        "migrations": { "properties": { "after": { "const": "001-075" }, "status": { "const": "verified" } } },
        "bundles": { "minItems": 2, "maxItems": 2, "prefixItems": [
          { "properties": { "audience": { "const": "client" }, "status": { "const": "verified" } } },
          { "properties": { "audience": { "const": "internal" }, "status": { "const": "verified" } } }
        ], "items": false },
        "images": { "minItems": 3, "maxItems": 3, "prefixItems": [
          { "properties": { "name": { "const": "main_crm" }, "status": { "const": "verified" } } },
          { "properties": { "name": { "const": "evo_inbox" }, "status": { "const": "verified" } } },
          { "properties": { "name": { "const": "lead_agent" }, "status": { "const": "verified" } } }
        ], "items": false },
        "containers_before": { "$ref": "#/$defs/verifiedContainers" },
        "containers_after": { "$ref": "#/$defs/verifiedContainers" },
        "rollback": { "properties": { "status": { "const": "verified" }, "images": { "$ref": "#/$defs/rollbackImages" }, "env_files": { "$ref": "#/$defs/rollbackEnvs" }, "compose_files": { "$ref": "#/$defs/rollbackCompose" } } },
        "pilot": { "minItems": 2, "maxItems": 2, "prefixItems": [
          { "properties": { "case_id": { "const": "client_china_documents" }, "audience": { "const": "client" }, "http_status": { "const": 200 }, "status": { "const": "verified" }, "expected_source_match": { "const": true }, "cross_audience_sources": { "const": 0 }, "audit_body_free": { "const": true } } },
          { "properties": { "case_id": { "const": "internal_malaysia_handoff" }, "audience": { "const": "internal" }, "http_status": { "const": 200 }, "status": { "const": "verified" }, "expected_source_match": { "const": true }, "cross_audience_sources": { "const": 0 }, "audit_body_free": { "const": true } } }
        ], "items": false }
      }
    }
  }],
  "$defs": {
    "verifiedContainer": { "properties": { "status": { "const": "verified" }, "healthy": { "const": true }, "restart_count": { "const": 0 } } },
    "verifiedContainers": { "minItems": 5, "maxItems": 5, "prefixItems": [
      { "allOf": [{ "$ref": "#/$defs/verifiedContainer" }, { "properties": { "name": { "const": "evo-inbox-app-1" } } }] },
      { "allOf": [{ "$ref": "#/$defs/verifiedContainer" }, { "properties": { "name": { "const": "evo-crm-app-1" } } }] },
      { "allOf": [{ "$ref": "#/$defs/verifiedContainer" }, { "properties": { "name": { "const": "evo-crm-lead-agent-1" } } }] },
      { "allOf": [{ "$ref": "#/$defs/verifiedContainer" }, { "properties": { "name": { "const": "evo-crm-waha-1" } } }] },
      { "allOf": [{ "$ref": "#/$defs/verifiedContainer" }, { "properties": { "name": { "const": "evo-inbox-waha" } } }] }
    ], "items": false },
    "rollbackImages": { "minItems": 3, "maxItems": 3, "prefixItems": [
      { "properties": { "name": { "const": "prior-crm.tar" } } }, { "properties": { "name": { "const": "prior-inbox.tar" } } }, { "properties": { "name": { "const": "prior-lead-agent.tar" } } }
    ], "items": false },
    "rollbackEnvs": { "minItems": 3, "maxItems": 3, "prefixItems": [
      { "properties": { "name": { "const": "crm.env.production" } } }, { "properties": { "name": { "const": "inbox.env.production" } } }, { "properties": { "name": { "const": "lead-agent.env.production" } } }
    ], "items": false },
    "rollbackCompose": { "minItems": 3, "maxItems": 3, "prefixItems": [
      { "properties": { "name": { "const": "crm.compose.yml" } } }, { "properties": { "name": { "const": "inbox.compose.yml" } } }, { "properties": { "name": { "const": "lead-agent.compose.yml" } } }
    ], "items": false }
  }
}
