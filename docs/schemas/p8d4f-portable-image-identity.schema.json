{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoadmissions.com/schemas/p8d4f-portable-image-identity.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_commit", "target_platform", "images"],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_commit": { "const": "aaa9f618131f604f79c694e4b332a0b13afd7a30" },
    "target_platform": { "$ref": "#/$defs/platform" },
    "images": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/crm" },
        { "$ref": "#/$defs/inbox" },
        { "$ref": "#/$defs/lead" }
      ],
      "items": false
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "variant"],
      "properties": {
        "os": { "const": "linux" },
        "architecture": { "const": "amd64" },
        "variant": { "const": "" }
      }
    },
    "manifest_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "media_type", "size"],
      "properties": {
        "digest": { "$ref": "#/$defs/sha" },
        "media_type": { "const": "application/vnd.oci.image.manifest.v1+json" },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "config_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "media_type", "size"],
      "properties": {
        "digest": { "$ref": "#/$defs/sha" },
        "media_type": { "const": "application/vnd.oci.image.config.v1+json" },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "layer_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "media_type", "size"],
      "properties": {
        "digest": { "$ref": "#/$defs/sha" },
        "media_type": {
          "enum": [
            "application/vnd.oci.image.layer.v1.tar",
            "application/vnd.oci.image.layer.v1.tar+gzip",
            "application/vnd.oci.image.layer.v1.tar+zstd"
          ]
        },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "size", "mode"],
      "properties": {
        "file": { "type": "string" },
        "sha256": { "$ref": "#/$defs/hex" },
        "size": { "type": "integer", "minimum": 1 },
        "mode": { "const": 600 }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tag", "source_commit", "platform", "oci_index_digest", "platform_manifest", "config", "layers", "archive"],
      "properties": {
        "name": { "type": "string" },
        "tag": { "type": "string" },
        "source_commit": { "const": "aaa9f618131f604f79c694e4b332a0b13afd7a30" },
        "platform": { "$ref": "#/$defs/platform" },
        "oci_index_digest": { "$ref": "#/$defs/sha" },
        "platform_manifest": { "$ref": "#/$defs/manifest_descriptor" },
        "config": { "$ref": "#/$defs/config_descriptor" },
        "layers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/layer_descriptor" } },
        "archive": { "$ref": "#/$defs/archive" }
      }
    },
    "crm": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "type": "object", "properties": {
          "name": { "const": "main_crm" },
          "tag": { "const": "evo-crm:aaa9f618131f604f79c694e4b332a0b13afd7a30-linux-amd64" },
          "oci_index_digest": { "const": "sha256:3174e8e35f27ca3983e971d6f4b94b6863a5b64a9ffd751042b3db5ed2f8c55a" },
          "platform_manifest": { "type": "object", "properties": { "digest": { "const": "sha256:34c0f3806a934c7b09c92cea6c4420a0c8ab3d2acb586e45a9b872f01f85d281" } } },
          "archive": { "type": "object", "properties": { "file": { "const": "evo-crm-aaa9f618131f604f79c694e4b332a0b13afd7a30-linux-amd64.tar" } } }
        } }
      ]
    },
    "inbox": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "type": "object", "properties": {
          "name": { "const": "evo_inbox" },
          "tag": { "const": "evo-inbox:aaa9f618131f604f79c694e4b332a0b13afd7a30-linux-amd64" },
          "oci_index_digest": { "const": "sha256:d7be064bdd690ac42f9e18fbcb32b8fb42eac32f588256a983393ede9f8b79ca" },
          "platform_manifest": { "type": "object", "properties": { "digest": { "const": "sha256:dfc1aae9743e2b6bf6d7e174933c36cd89e03e5d769b859f2aaaa557a7a68af3" } } },
          "archive": { "type": "object", "properties": { "file": { "const": "evo-inbox-aaa9f618131f604f79c694e4b332a0b13afd7a30-linux-amd64.tar" } } }
        } }
      ]
    },
    "lead": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "type": "object", "properties": {
          "name": { "const": "lead_agent" },
          "tag": { "const": "evo-lead-agent:aaa9f618131f604f79c694e4b332a0b13afd7a30-linux-amd64" },
          "oci_index_digest": { "const": "sha256:9194b569df458a7a80792ca3f4aebfa417204961f229585178aa91c710d45c01" },
          "platform_manifest": { "type": "object", "properties": { "digest": { "const": "sha256:a50289ffadf3e73b121a56fd1a5621164ddc9e723a58e8280a0a8536f7484ac3" } } },
          "archive": { "type": "object", "properties": { "file": { "const": "evo-lead-agent-aaa9f618131f604f79c694e4b332a0b13afd7a30-linux-amd64.tar" } } }
        } }
      ]
    }
  }
}
