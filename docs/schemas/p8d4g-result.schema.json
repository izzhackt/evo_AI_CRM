        "status": { "enum": ["not_required", "verified", "failed"] },
        "local_roots_removed": { "type": "integer", "minimum": 0, "maximum": 4 },
        "remote_pairs_removed": { "type": "integer", "minimum": 0, "maximum": 2 },
        "container_pairs_removed": { "type": "integer", "minimum": 0, "maximum": 2 },
        "importer_removed": { "type": "boolean" }
      }
    }
  }
