          "knowledge": { "properties": { "status": { "const": "verified" }, "cleanup_status": { "const": "verified" }, "audiences": { "minItems": 2 } } },
          "configuration": { "properties": { "status": { "const": "verified" }, "root_crm": { "const": "verified" }, "lead_agent": { "const": "verified" }, "manual_worker": { "const": "verified" }, "configured_account_match": { "const": true }, "configured_organization_match": { "const": true }, "supabase_project_match": { "const": true }, "blockers": { "maxItems": 0 } } },
          "steps": { "prefixItems": [
