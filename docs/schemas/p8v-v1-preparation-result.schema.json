  "allOf": [
    {
      "if": { "properties": { "result_code": { "const": "preparation_verified" } } },
      "then": {
        "properties": {
          "blocker": { "type": "null" }, "images": { "minItems": 3 }, "production_containers": { "minItems": 5 }, "collection": { "properties": { "index_sha256": { "$ref": "#/$defs/sha64" } } },
          "migration": { "properties": { "status": { "const": "verified" }, "repository_range": { "const": "001-077" }, "repository_count": { "const": 77 }, "production_range": { "const": "001-076" }, "production_count": { "const": 76 }, "pending_versions": { "const": ["077"] }, "project_status": { "const": "ACTIVE_HEALTHY" } } },
