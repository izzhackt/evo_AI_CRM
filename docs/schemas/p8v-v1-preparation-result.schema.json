          { "$ref": "#/$defs/failureAt0" }, { "$ref": "#/$defs/failureAt1" }, { "$ref": "#/$defs/failureAt2" }, { "$ref": "#/$defs/failureAt3" }, { "$ref": "#/$defs/failureAt4" }, { "$ref": "#/$defs/failureAt5" }, { "$ref": "#/$defs/failureAt6" }, { "$ref": "#/$defs/failureAt7" }
        ]
      }
    },
    {
      "if": { "properties": { "result_code": { "const": "preparation_blocked" } } },
      "then": { "properties": { "steps": { "not": { "contains": { "properties": { "status": { "const": "failed" } }, "required": ["status"] } } } } }
    },
    {
      "if": { "properties": { "result_code": { "const": "evidence_failed" } } },
      "then": { "properties": { "steps": { "contains": { "properties": { "status": { "const": "failed" } }, "required": ["status"] }, "minContains": 1, "maxContains": 1 } } }
    }
  ]
}
