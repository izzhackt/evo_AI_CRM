# Runtime
EVO_AGENT_ENV=local
EVO_AGENT_DB_PATH=data/evo-lead-agent.db

# Safety switches. This retained module is frozen; keep every worker, automatic
# reply, and outbound authority disabled in local and production environments.
EVO_AGENT_AUTOREPLY_ENABLED=false
EVO_AGENT_OUTBOUND_ENABLED=false
EVO_AGENT_MAX_REPLY_CHARS=900
EVO_AGENT_REPLY_DELAY_SECONDS=30
EVO_AGENT_FROZEN=true
EVO_AGENT_WORKER_ENABLED=false
EVO_AGENT_WORKER_POLL_INTERVAL_SECONDS=2
EVO_AGENT_STARTER_KNOWLEDGE_PATH=examples/evo-admissions-starter-knowledge.json

# WAHA private service.
# Server sibling service: http://evo-crm-waha:3000
# Local Docker hitting WAHA on the host: http://host.docker.internal:3000
EVO_AGENT_WAHA_BASE_URL=http://evo-crm-waha:3000
EVO_AGENT_WAHA_API_KEY=
EVO_AGENT_WAHA_SESSION=evo-inbox
# Retained rollback evidence only. The frozen Lead Agent and its retired setup
# command do not configure the target Platform webhook. Never copy the Platform
# ingress HMAC secret into these legacy variables.
EVO_AGENT_WAHA_WEBHOOK_SECRET=
EVO_AGENT_WAHA_WEBHOOK_URL=

# WAHA container API key. Prefer sha512:<hash> here; keep the plain value only
# in EVO_AGENT_WAHA_API_KEY for the lead-agent client.
WAHA_API_KEY=

# amoCRM source of truth
EVO_AGENT_AMO_BASE_URL=https://example.amocrm.ru
EVO_AGENT_AMO_CLIENT_ID=
EVO_AGENT_AMO_CLIENT_SECRET=
EVO_AGENT_AMO_REDIRECT_URI=
EVO_AGENT_AMO_REFRESH_TOKEN=
EVO_AGENT_AMO_TOKEN_FILE=data/amo-token.json
EVO_AGENT_AMO_PIPELINE_ID=
EVO_AGENT_AMO_STATUS_ID=
EVO_AGENT_AMO_RESPONSIBLE_USER_ID=

# EVO CRM private callback. Secret must match CRM `lead_agent_sync_secret`.
EVO_AGENT_CRM_BASE_URL=http://evo-crm-app:3000
EVO_AGENT_CRM_SYNC_PATH=/api/internal/lead-agent/whatsapp
EVO_AGENT_CRM_SYNC_SECRET=
EVO_AGENT_CRM_SYNC_TIMEOUT_SECONDS=10

# Private admin API for local/import tooling. Never expose publicly.
EVO_AGENT_ADMIN_API_KEY=

# LLM
# Google Gen AI SDK also accepts GOOGLE_API_KEY; GEMINI_API_KEY is the rollout default.
GEMINI_API_KEY=
EVO_AGENT_GEMINI_MODEL=gemini-3.5-flash
