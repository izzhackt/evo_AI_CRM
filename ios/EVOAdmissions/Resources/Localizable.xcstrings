      }
    },
    "result_orvis_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Орточо жооп канчалык жогору болсо, бул топтогу иштерге кызыгуу ошончолук чоң. Бул жөндөмдүн баасы эмес жана бир кесипти тандоо буйругу эмес."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более высокий средний ответ показывает больший интерес к занятиям этой группы. Это не оценка способностей и не предписание выбрать одну профессию."
          }
        }
      }
    },
