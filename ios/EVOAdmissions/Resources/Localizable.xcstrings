{
  "sourceLanguage" : "ru",
  "strings" : {
    "program_document_notification_snapshot" : {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это решение из уведомления. Текущее состояние и более поздние отправки доступны в программе."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул — билдирүүдөгү чечим. Учурдагы абал жана кийинки жөнөтүүлөр программада жеткиликтүү."
          }
        }
      }
    },
    "program_document_open_program" : {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть подготовку по программе"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Программа боюнча даярдыкты ачуу"
          }
        }
      }
    },
    "program_document_review_detail" : {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решение по документу"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Документ боюнча чечим"
          }
        }
      }
    },
    "program_document_changed_refresh" : {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требования или отправка изменились. Данные обновлены: проверьте файл и отправьте нужную версию снова."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Талаптар же жөнөтүү өзгөрдү. Маалымат жаңыртылды: файлды текшерип, керектүү нусканы кайра жөнөтүңүз."
          }
        }
      }
    },
    "program_document_upload_not_saved" : {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не сохранён. Проверьте требования и файл, затем повторите загрузку."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл сакталган жок. Талаптарды жана файлды текшерип, кайра жүктөңүз."
          }
        }
      }
    },
    "program_document_invalid_file" : {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите PDF, JPG или PNG до 25 МБ с обычным именем файла."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадимки аталыштагы, 25 МБга чейинки PDF, JPG же PNG файлын тандаңыз."
          }
        }
      }
    },
    "program_document_event_saved" : {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл сохранён"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл сакталды"
          }
        }
      }
    },
    "program_document_saved" : {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранён, ещё не отправлен"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сакталды, жөнөтүлө элек"
          }
        }
      }
    },
    "program_document_sent" : {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлен на проверку"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Текшерүүгө жөнөтүлдү"
          }
        }
      }
    },
    "program_document_submit" : {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
