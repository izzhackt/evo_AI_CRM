    "profile_delete_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баскыч EVO командасына сурам жөнөтөт — дароо эч нерсе өчүрүлбөйт. Команда сурамды иштеп чыгып, кабинетке кирүүнү жабат: тандалмалар, тест жыйынтыктары жана жүктөлгөн материалдар жеткиликсиз болот. Келишим жана мыйзам боюнча сакталууга тийиш жазуулар колдонуудагы эрежелер боюнча сакталат."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка отправляет запрос команде EVO — сразу ничего не удаляется. Команда обработает запрос и закроет доступ к кабинету: избранное, результаты тестов и загруженные материалы станут недоступны. Записи, которые обязаны храниться по договору и закону, сохраняются по действующим правилам."
          }
        }
      }
    },
