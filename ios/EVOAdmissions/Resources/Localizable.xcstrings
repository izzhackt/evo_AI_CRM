    "result_english_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бул ушул тапшырмалар топтомунун жыйынтыгы, тил деңгээлинин сертификаты эмес. Угуу, сүйлөө жана жазуу бааланган жок."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это результат этого набора заданий, не сертификат уровня языка. Аудирование, разговорная речь и письмо не оценивались."
          }
        }
      }
    },
    "result_limitations_heading" : {
      "extractionState" : "manual",
      "localizations" : {
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
