            },
            {
              "tex": "x > 0"
            }
          ],
          [
            {
              "ky": "Маанилер областы",
              "ru": "Множество значений"
            },
            {
              "tex": "y > 0"
            },
            {
              "tex": "y \\in \\mathbb{R}"
            }
          ],
          [
            {
              "ky": "Таяныч чекит",
              "ru": "Опорная точка"
            },
            {
