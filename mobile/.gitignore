# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Expo prebuild (CNG): native projects are generated, not committed
/ios
/android

# local env (values are public client config, still per-machine)
.env

# local dev stack (synthetic, per-machine; never commit)
.env.local-stack*
.local-stack-accounts.json
