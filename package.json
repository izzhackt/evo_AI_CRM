{
  "name": "edu-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:node-runtime": "node scripts/check-node-runtime.mjs",
    "preinstall": "node scripts/check-node-runtime.mjs",
    "predev": "node scripts/check-node-runtime.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/check-node-runtime.mjs",
    "build": "next build",
    "prestart": "node scripts/check-node-runtime.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node --experimental-strip-types --test tests/prepared-ai-drawer-state.test.mjs tests/role-contract.test.mjs tests/supabase-history.test.mjs tests/platform-auth-config.test.mjs tests/platform-communications.test.mjs",
    "test:a11y": "playwright test tests/e2e/platform-accessibility.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:security": "npm run test:supabase:history && npm run test:security:node && npm run test:security:postgres",
    "test:security:node": "node --experimental-strip-types --test tests/secret-storage.test.mjs tests/transcription-jobs.test.mjs tests/request-limits.test.mjs tests/runtime-hardening.test.mjs tests/disaster-recovery.test.mjs tests/visa-role-migration.test.mjs tests/p1c-object-access-policy.test.mjs tests/student-case-policy.test.mjs tests/p1d-whatsapp-policy.test.mjs tests/p1d-whatsapp-query-scope.test.mjs tests/postgres-test-image-fallback.test.mjs tests/platform-auth-config.test.mjs",
    "test:security:postgres": "bash scripts/test-postgres-authorization.sh",
    "test:supabase:history": "node scripts/verify-supabase-history.mjs",
    "test:supabase:local": "bash scripts/test-supabase-local-reset.sh",
    "scenarios": "EVO_SECRET_ENCRYPTION_KEY=scenario-evaluation-only-key node scripts/evaluate-scenarios.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "backup:db": "node scripts/backup-sqlite.mjs",
    "migrate:visa-role": "node scripts/migrate-visa-role.mjs",
    "promise-audit": "node scripts/check-promise-audit.mjs",
    "public-promise-audit": "node scripts/audit-public-promises.mjs --write",
    "public-promise-audit:self-test": "node scripts/audit-public-promises.mjs --self-test"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/three": "^0.185.0",
    "better-sqlite3": "^12.10.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "supabase": "2.110.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.0"
  }
}
