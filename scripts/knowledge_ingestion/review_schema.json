{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "title", "section", "summary", "facts", "sources", "reason"],
        "properties": {
          "decision": {"enum": ["approve", "escalate", "ignore"]},
          "title": {"type": "string", "minLength": 1},
          "section": {"enum": ["Страны", "Университеты", "Услуги", "Процессы", "Продажи и ответы", "Компания", "Команда", "Партнеры", "Неопределенное"]},
          "summary": {"type": "string"},
          "facts": {"type": "array", "items": {"type": "string"}},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
